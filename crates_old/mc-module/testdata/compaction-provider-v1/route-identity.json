{
  "identity_cases": [
    {
      "name": "shared project route uses Setup identity for conversation calls",
      "incoming_route": {
        "principal": {"value": "reserved:runner-a", "daemon_attested": true},
        "bind": {"harness": "runner", "session": "", "project_root": "/work/project"}
      },
      "setup": {"harness": "harness-a", "session": "conversation-1"},
      "expected": {
        "setup": "accept",
        "conversation_calls": ["session.read", "session.head", "session.resolve", "session.send", "reminder"],
        "runner_principal": "reserved:runner-a",
        "reverse_bind": {"harness": "harness-a", "session": "conversation-1", "project_root": "/work/project"}
      }
    },
    {
      "name": "single-session route may use a generic harness",
      "incoming_route": {
        "principal": {"value": "reserved:runner-a", "daemon_attested": true},
        "bind": {"harness": "runner", "session": "conversation-2", "project_root": "/work/project"}
      },
      "setup": {"harness": "harness-a", "session": "conversation-2"},
      "expected": {
        "setup": "accept",
        "runner_principal": "reserved:runner-a",
        "reverse_bind": {"harness": "harness-a", "session": "conversation-2", "project_root": "/work/project"}
      }
    },
    {
      "name": "different single-session route may be refused by name",
      "incoming_route": {
        "principal": {"value": "reserved:runner-a", "daemon_attested": true},
        "bind": {"harness": "runner", "session": "another-session", "project_root": "/work/project"}
      },
      "setup": {"harness": "harness-a", "session": "conversation-3"},
      "expected": {"setup": "refuse", "code": "setup_identity_mismatch"}
    },
    {
      "name": "child run gets a new session under the attested runner and Setup harness",
      "incoming_route": {
        "principal": {"value": "reserved:runner-a", "daemon_attested": true},
        "bind": {"harness": "runner", "session": "", "project_root": "/work/project"}
      },
      "setup": {"harness": "harness-a", "session": "conversation-4"},
      "child_session": "summarizer-1",
      "expected": {
        "runner_principal": "reserved:runner-a",
        "child_bind": {"harness": "harness-a", "session": "summarizer-1", "project_root": "/work/project"},
        "forbidden_child_bind_session": "conversation-4"
      }
    },
    {
      "name": "caller-chosen harness does not authenticate an unattested route",
      "incoming_route": {
        "principal": {"value": "caller-chosen:runner", "daemon_attested": false},
        "bind": {"harness": "runner", "session": "", "project_root": "/work/project"}
      },
      "setup": {"harness": "harness-a", "session": "conversation-5"},
      "expected": {"runner_authenticated": false}
    }
  ],
  "provider_faults": [
    {
      "name": "reusing the shared route's empty session cannot read the conversation",
      "incoming_route": {"harness": "runner", "session": "", "project_root": "/work/project"},
      "setup": {"harness": "harness-a", "session": "conversation-6"},
      "expected_reverse_bind": {"harness": "harness-a", "session": "conversation-6", "project_root": "/work/project"},
      "faulty_reverse_bind": {"harness": "runner", "session": "", "project_root": "/work/project"}
    },
    {
      "name": "a constant harness misses the Setup conversation identity",
      "incoming_route": {"harness": "runner", "session": "conversation-7", "project_root": "/work/project"},
      "setup": {"harness": "harness-a", "session": "conversation-7"},
      "expected_reverse_bind": {"harness": "harness-a", "session": "conversation-7", "project_root": "/work/project"},
      "faulty_reverse_bind": {"harness": "runner", "session": "conversation-7", "project_root": "/work/project"}
    }
  ]
}
