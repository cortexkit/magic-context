# Vendored cross-language golden fixtures must stay LF-deterministic across
# platforms so byte-compare drift checks (and any byte-level fixture assertions)
# behave identically on Windows. Mirrors the producer-side .gitattributes that
# pins ck_wire_golden.json to LF.
crates/mc-module/testdata/*.json text eol=lf
crates/mc-module/testdata/codec/*.json text eol=lf
crates/mc-module/testdata/codec/*.ts text eol=lf

# Committed build output of the Claude Code plugin (see .gitignore): collapsed in
# reviews and diffs, regenerated by `bun run --cwd packages/claude-code-plugin build`.
packages/claude-code-plugin/dist/** linguist-generated=true -diff
