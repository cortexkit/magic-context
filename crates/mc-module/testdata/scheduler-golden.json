  "threshold_cases": [
    {
      "label": "percentage numeric below cap",
      "percentage_config": 65,
      "fallback": 65,
      "expected": 65
    },
    {
      "label": "percentage cap at 90",
      "percentage_config": 95,
      "fallback": 65,
      "expected": 90
    },
    {
      "model_key": "anthropic/claude-sonnet-4-20250514",
      "label": "per-model exact match",
      "percentage_config": {
        "default": 65,
        "anthropic/claude-sonnet-4-20250514": 72
      },
      "fallback": 65,
      "expected": 72
    },
    {
      "model_key": "openai/gpt-5.4-fast",
      "label": "per-model derived bare model fallback",
      "percentage_config": {
        "default": 65,
        "gpt-5.4": 58
      },
      "fallback": 65,
      "expected": 58
    },
    {
      "model_key": "openai/gpt-6-astra",
      "label": "provider wildcard keys are not threshold candidates",
      "percentage_config": {
        "default": 75,
        "openai/*": 30
      },
      "fallback": 65,
      "expected": 75
    },
    {
      "model_key": "opencode/test-model",
      "label": "OMP provider spelling resolves from canonical threshold identity",
      "percentage_config": {
        "default": 75,
        "opencode-zen/test-model": 70
      },
      "fallback": 65,
      "expected": 70
    },
    {
      "tokens_config": {
        "default": 32000
      },
      "context_limit": 50000,
      "label": "tokens config with explicit context limit",
      "percentage_config": 65,
      "fallback": 65,
      "expected": 64
    },
    {
      "tokens_config": {
        "default": 90000
      },
      "context_limit": 100000,
      "label": "tokens config cap at 80 percent",
      "percentage_config": 65,
      "fallback": 65,
      "expected": 90
    },
    {
      "tokens_config": {
        "default": 30000,
        "openai/gpt-5.4-fast": 20000
      },
      "model_key": "openai/gpt-5.4-fast",
      "context_limit": 100000,
      "label": "tokens model key wins over default",
      "percentage_config": {
        "default": 60
      },
      "fallback": 65,
      "expected": 20
    },
    {
      "tokens_config": {
        "default": 30000
      },
      "label": "tokens config without context limit falls back to percentage",
      "percentage_config": {
        "default": 62
      },
      "fallback": 65,
      "expected": 62
    }
  ],
  "should_execute_cases": [
    {
      "label": "fresh session guard defers",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 0,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 0,
        "input_tokens": 0
      },
      "now_ms": 300001,
      "expected": "defer",
      "expected_threshold": 65
    },
    {
      "label": "percentage below threshold defers",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 64.9,
        "input_tokens": 64900
      },
      "now_ms": 2000,
      "expected": "defer",
      "expected_threshold": 65
    },
    {
      "label": "percentage exactly threshold executes",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 65,
        "input_tokens": 65000
      },
      "now_ms": 2000,
      "expected": "execute",
      "expected_threshold": 65
    },
    {
      "label": "percentage above threshold executes",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 65.1,
        "input_tokens": 65100
      },
      "now_ms": 2000,
      "expected": "execute",
      "expected_threshold": 65
    },
    {
      "label": "tokens threshold explicit context limit defers below tokens",
      "config": {
        "execute_threshold_percentage": 65,
        "execute_threshold_tokens": {
          "default": 32000
        }
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 31.9,
        "input_tokens": 31900
      },
      "now_ms": 2000,
      "context_limit": 100000,
      "expected": "defer",
      "expected_threshold": 32
    },
    {
      "label": "tokens threshold explicit context limit executes at tokens",
      "config": {
        "execute_threshold_percentage": 65,
        "execute_threshold_tokens": {
          "default": 32000
        }
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 32,
        "input_tokens": 32000
      },
      "now_ms": 2000,
      "context_limit": 100000,
      "expected": "execute",
      "expected_threshold": 32
    },
    {
      "label": "tokens threshold derived context limit executes",
      "config": {
        "execute_threshold_percentage": 65,
        "execute_threshold_tokens": {
          "default": 50000
        }
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 50,
        "input_tokens": 50000
      },
      "now_ms": 2000,
      "expected": "execute",
      "expected_threshold": 50
    },
    {
      "label": "per-model percentage map executes",
      "config": {
        "execute_threshold_percentage": {
          "default": 65,
          "openai/gpt-5.4": 58
        }
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 58,
        "input_tokens": 58000
      },
      "now_ms": 2000,
      "model_key": "openai/gpt-5.4-fast",
      "expected": "execute",
      "expected_threshold": 58
