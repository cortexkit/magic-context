    {
      "label": "80 percent cap executes at cap",
      "config": {
        "execute_threshold_percentage": 95
      },
      "session": {
        "last_response_time_ms": 1000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 80,
        "input_tokens": 80000
      },
      "now_ms": 2000,
      "expected": "defer",
      "expected_threshold": 90
    },
    {
      "label": "scheduler ttl boundary defers on equality",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 10000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 10,
        "input_tokens": 10000
      },
      "now_ms": 310000,
      "expected": "defer",
      "expected_threshold": 65
    },
    {
      "label": "scheduler ttl fires after equality",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 10000,
        "cache_ttl": "5m"
      },
      "usage": {
        "percentage": 10,
        "input_tokens": 10000
      },
      "now_ms": 310001,
      "expected": "execute",
      "expected_threshold": 65
    },
    {
      "label": "invalid ttl falls back to default 5m",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 10000,
        "cache_ttl": "nonsense"
      },
      "usage": {
        "percentage": 10,
        "input_tokens": 10000
      },
      "now_ms": 310001,
      "expected": "execute",
      "expected_threshold": 65
    },
    {
      "label": "bare numeric ttl is milliseconds",
      "config": {
        "execute_threshold_percentage": 65
      },
      "session": {
        "last_response_time_ms": 10000,
        "cache_ttl": "1000"
      },
      "usage": {
        "percentage": 10,
        "input_tokens": 10000
      },
      "now_ms": 11001,
      "expected": "execute",
      "expected_threshold": 65
    }
  ],
  "ttl_predicate_cases": [
    {
      "label": "elapsed equals ttl",
      "now_ms": 310000,
      "last_response_time_ms": 10000,
      "ttl_ms": 300000,
      "expected_execute_fired": false,
      "expected_hard_expired": false
    },
    {
      "label": "elapsed ttl plus one",
      "now_ms": 310001,
      "last_response_time_ms": 10000,
      "ttl_ms": 300000,
      "expected_execute_fired": true,
      "expected_hard_expired": true
    },
    {
      "label": "last response zero never hard expires",
      "now_ms": 300001,
      "last_response_time_ms": 0,
      "ttl_ms": 300000,
      "expected_execute_fired": true,
      "expected_hard_expired": false
    }
  ],
