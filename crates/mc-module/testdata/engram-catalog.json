      "mechanism": "filetree",
      "path": "agent-data"
    },
    {
      "entry_id": "magic-context/embedding-models",
      "class": "rebuild",
      "mechanism": "filetree",
      "path": "models"
    },
    {
      "entry_id": "magic-context/model-context-limits-opencode",
