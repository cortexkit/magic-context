{
  "schema_version": 1,
  "module_id": "magic-context",
  "entries": [
    {
      "entry_id": "magic-context/context-db",
      "class": "portable",
      "mechanism": "page-db",
      "path": "context.db",
      "writer_interaction": "read-transaction-live",
      "exclude_tables": [
        "lkg_slots",
        "lkg_slot_chunks"
      ]
    },
    {
      "entry_id": "magic-context/module-store",
      "class": "portable",
      "mechanism": "whole-db",
      "path": "store.db",
      "writer_interaction": "backup-api-live"
    },
    {
      "entry_id": "magic-context/project-identities",
      "class": "portable",
      "mechanism": "filetree",
      "path": "project-identities"
    },
    {
      "entry_id": "magic-context/rpc",
      "class": "device-local",
      "mechanism": "filetree",
      "path": "rpc"
    },
    {
      "entry_id": "magic-context/lkg-recovery-fences",
      "class": "device-local",
      "mechanism": "filetree",
      "path": "lkg-recovery-fences"
    },
    {
      "entry_id": "magic-context/pi-served-array-digests",
      "class": "device-local",
