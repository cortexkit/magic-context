    {
      "entry_id": "magic-context/github-token",
      "class": "excluded",
      "mechanism": "filetree",
      "path": "github-token",
      "reason": "secret: a user-placed GitHub token; place it again on the new machine"
    },
    {
      "entry_id": "magic-context/logs",
      "class": "excluded",
      "mechanism": "filetree",
