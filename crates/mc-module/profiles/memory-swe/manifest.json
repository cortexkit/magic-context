        "sections": [
          {
            "id": "persona",
            "override": true,
            "file": "prompts/historian/system/persona.md"
          },
          {
            "id": "how-magic-context-works",
            "override": true,
            "file": "prompts/historian/system/how-magic-context-works.md"
          },
          {
