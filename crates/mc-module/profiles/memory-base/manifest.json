            "file": "prompts/historian/system/facts-general-rules.md"
          },
          {
            "id": "time-and-certainty",
            "file": "prompts/historian/system/time-and-certainty.md"
          },
          {
            "id": "categories-intro",
            "requires": "fact_categories",
            "file": "prompts/historian/system/categories-intro.md"
          },
          {
            "id": "fact-category-definitions",
