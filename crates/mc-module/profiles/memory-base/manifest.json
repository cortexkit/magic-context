          },
          {
            "id": "tiers-voice-and-cross-tier",
            "file": "prompts/historian/system/tiers-voice-and-cross-tier.md"
          },
          {
            "id": "tiers-p1-to-p4",
            "file": "prompts/historian/system/tiers-p1-to-p4.md"
          },
          {
