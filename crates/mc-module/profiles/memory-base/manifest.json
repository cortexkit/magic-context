            "file": "prompts/historian/system/what-you-produce.md"
          },
          {
            "id": "world-experience-split",
            "file": "prompts/historian/system/world-experience-split.md"
          },
          {
            "id": "inputs",
            "file": "prompts/historian/system/inputs.md"
          },
          {
            "id": "input-notation",
            "mc": "historian/input-notation"
          },
          {
            "id": "compartment-boundaries",
            "file": "prompts/historian/system/compartment-boundaries.md"
          },
          {
            "id": "episode-type",
            "file": "prompts/historian/system/episode-type.md"
          },
          {
            "id": "boundary-other-rules",
            "file": "prompts/historian/system/boundary-other-rules.md"
          },
          {
            "id": "importance-bands",
            "file": "prompts/historian/system/importance-bands.md"
