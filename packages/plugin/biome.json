{
    "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "assist": {
        "enabled": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noForEach": "off"
            },
            "style": {
                "noNonNullAssertion": "warn",
                "useConst": "error"
            },
            "suspicious": {
                "noExplicitAny": "warn",
                "noAssignInExpressions": "off",
                "noTemplateCurlyInString": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "files": {
        "includes": ["src/**/*.ts", "scripts/**/*.mjs"]
    },
    "overrides": [
        {
            "includes": ["**/__tests__/**", "**/*.test.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        },
        {
            "includes": ["src/hooks/magic-context/image-token-estimate.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        }
    ]
}
